# ==============================================================================
# ShortLink Environment Configuration
# ==============================================================================

# Supabase Project URL (found in Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (safe to expose to client-side browsers)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (CONFIDENTIAL - server-side only for fast redirect & admin queries)
# NEVER expose this key in client-side code or public repositories.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Canonical Public Website URL (e.g. https://shortlink.dev or http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database Password (provided during Supabase setup)
DB_PASS=kfmcd0vrKW3MX6Vd
